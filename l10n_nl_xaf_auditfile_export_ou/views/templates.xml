<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="auditfile_template_inherit" inherit_id="l10n_nl_xaf_auditfile_export.auditfile_template">

        <xpath expr='//companyIdent/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.coc_registration_number or self.company_id.company_registry</attribute>
        </xpath>
        <xpath expr='//companyName/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.name or self.company_id.name</attribute>
        </xpath>
        <xpath expr='//taxRegistrationCountry/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.country_id.code or self.company_id.country_id.code</attribute>
        </xpath>
        <xpath expr='//taxRegIdent/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.vat or self.company_id.vat</attribute>
        </xpath>
        <xpath expr='//streetAddress/streetname/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.street or self.company_id.street</attribute>
        </xpath>
        <xpath expr='//streetAddress/city/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.city or self.company_id.city</attribute>
        </xpath>
        <xpath expr='//streetAddress/postalCode/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.zip or self.company_id.zip</attribute>
        </xpath>
        <xpath expr='//streetAddress/region/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.state_id.name or self.company_id.state_id.name</attribute>
        </xpath>
        <xpath expr='//streetAddress/country/t' position="attributes">
            <attribute name="t-esc">self.operating_unit_id.partner_id.country_id.code or self.company_id.country_id.code</attribute>
        </xpath>

    </template>

</odoo>
