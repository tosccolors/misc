<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form - only confirmed bank accounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='partner_bank_id'])[1]" position="attributes">
                <attribute name="domain">[('partner_id', '=', bank_partner_id), ('state', '=', 'confirmed')]</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_bank_id'])[2]" position="attributes">
                <attribute name="domain">[('partner_id', '=', bank_partner_id), ('state', '=', 'confirmed')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
