<odoo>
    <record id="action_move_validator" model="ir.actions.act_window">
        <field name="name">Move validation</field>
        <field name="res_model">account.move</field>
        <field name="groups_id" eval="[Command.link(ref('group_move_validator'))]" />
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_has_reviews': True}</field>
    </record>
    <menuitem id="menu_move_validator_root"
        name="Move validation"
        groups="group_move_validator"
        action="action_move_validator"
        web_icon="account,static/description/icon.png"
    />
</odoo>
