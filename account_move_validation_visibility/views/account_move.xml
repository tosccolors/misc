<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id' and @groups]" position="attributes">
                <attribute name="groups" add="account_move_validation_visibility.group_move_validator" separator="," />
            </xpath>
        </field>
    </record>
    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_move_tier_validation.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="tier_validated" position="before">
                <filter name="has_reviews" string="Has reviews" domain="[('review_ids', '!=', False)]" />
            </filter>
        </field>
    </record>
</odoo>
