<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Invoice  (form)
        -->
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <field name="invoice_payment_term_id" position="after">
                    <field name="has_failed2confirm" invisible="1"/>
                </field>
            </field>
        </record>


        <!--
            Invoice  (search)
        -->
        <record id="view_account_invoice_filter_inherit" model="ir.ui.view">
            <field name="name">account.invoice.select</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                  <xpath expr="//search/field[@name='partner_id']" position="after">
                      <field name="has_failed2confirm"/>
                      <filter name="f2confirm" string="Failed to Auto-Validate"
                            domain="[('has_failed2confirm','=',True)]"/>
                  </xpath>
            </field>
        </record>

    </data>
</odoo>