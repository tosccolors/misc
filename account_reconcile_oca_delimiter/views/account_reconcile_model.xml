<odoo>
    <record id="view_account_reconcile_model_form" model="ir.ui.view">
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form" />
        <field name="arch" type="xml">
            <xpath expr="//div/field[@name='match_text_location_reference']/.." position="after">
                <field name="extra_statement_text_delimiters" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}" />
            </xpath>
        </field>
    </record>
</odoo>
