<odoo>
    <record id="account_account_reconcile_form_view" model="ir.ui.view">
        <field name="model">account.account.reconcile</field>
        <field name="inherit_id" ref="account_reconcile_oca.account_account_reconcile_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='account_id']/.." position="after">
                <group>
                    <field name="balance" />
                </group>
            </xpath>
            <xpath expr="//group/field[@name='account_id']/../.." position="attributes">
                <attribute name="col">3</attribute>
            </xpath>
        </field>
    </record>
</odoo>
