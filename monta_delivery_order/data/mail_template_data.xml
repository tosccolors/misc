<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('name', '=', 'mail_template_data_delivery_confirmation'), ('module', '=', 'stock')]" />
        </function>
        <value eval="{'noupdate': False}" />
    </function>


    <record id="stock.mail_template_data_delivery_confirmation" model="mail.template">
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,<br/><br/>
                    We are glad to inform you that your order has been shipped.
                    <t t-if="hasattr(object, 'carrier_tracking_ref') and object.carrier_tracking_ref">
                        Your tracking reference is
                        <strong>
                        <t t-if="object.monta_carrier_tracking_url">
                            <t t-set="multiple_carrier_tracking" t-value="object.get_multiple_carrier_tracking()"/>
                            <t t-if="multiple_carrier_tracking">
                                <t t-foreach="multiple_carrier_tracking" t-as="line">
                                    <br/><a t-att-href="line[1]" target="_blank" t-out="line[0] or ''"></a>
                                </t>
                            </t>
                            <t t-else="">
                                <a t-attf-href="{{ object.monta_carrier_tracking_url }}" target="_blank" t-out="object.carrier_tracking_ref or ''"></a>.
                            </t>
                        </t>
                        <t t-else="">
                            <t t-out="object.carrier_tracking_ref or ''"></t>.
                        </t>
                        </strong>
                    </t>
                    <br/><br/>
                    Please find your delivery order attached for more details.<br/><br/>
                    Thank you,
                    <t t-if="user.signature">
                        <br />
                        <t t-out="user.signature or ''">--<br/>Mitchell Admin</t>
                    </t>
                </p>
            </div>
        </field>
    </record>

    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('name', '=', 'mail_template_data_delivery_confirmation'), ('module', '=', 'stock')]" />
        </function>
        <value eval="{'noupdate': True}" />
    </function>



    <!--
        Mail: Monta: Notify unprocessed Batch details
    -->
    <record id="email_template_notify_monta_exception" model="mail.template">
            <field name="name">NUUD | Notify salesperson/buyer: missing batch information in Montaportal</field>
            <field name="model_id" ref="model_picking_from_odooto_monta"/>
            <field name="subject">Error: missing batch information in Montaportal for order {{ object.monta_order_name or 'n/a' }}</field>
            <field name="email_from">{{ ((object.sale_id.company_id.email_formatted if object.sale_id else object.purchase_id.company_id.email_formatted) or  user.email_formatted) }}</field>
            <field name="partner_to">{{ object.sale_id.user_id.id if object.sale_id else object.purchase_id.user_id.id}}</field>
            <field name="description">Used to notify salespeople/buyer when outbound/inbound orders are failed to be processed in Odoo due to Batch issue</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;">

        Hi <t t-if="object.sale_id and object.sale_id.user_id.name">
                <span style="font-weight:bold;" t-out="object.sale_id.user_id.name or ''"></span>,
            </t>
            <t t-else="object.purchase_id and object.purchase_id.user_id.name">
                <span style="font-weight:bold;" t-out="object.purchase_id.user_id.name or ''"></span>,
            </t>
        <br/><br/>
        Unfortunately, order <span style="font-weight:bold;" t-out="object.monta_order_name or ''"></span> cannot be processed in Odoo due to missing batch information in the Monta portal.
        Please reach out to the Monta Servicedesk to make sure that the required batch information is added to this order in the Monta portal.
        Once the batch information is complete in the Monta portal, the order will be processed automatically in Odoo.
        <br/><br/>
        Thank you!

        <br/>
    </p><div style="text-align: left;"><strong style="box-sizing:border-box;font-weight:500;">nuud | fresh armpits worldwide</strong></div>
    <p style="margin:0px 0 12px 0;box-sizing:border-box;"></p>
</div>
            </field>
            <field name="lang">{{ object.sale_id.user_id.lang if object.sale_id else object.purchase_id.user_id.lang}}</field>
            <field name="auto_delete" eval="True"/>
        </record>


</data>
</odoo>
