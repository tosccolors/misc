<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Monta Log
     -->
    <record id="monta_log_view" model="ir.ui.view">
        <field name="name">monta.log.view</field>
        <field name="model">monta.sync.log</field>
        <field name="arch" type="xml">
            <tree string="Monta Logs" create="0" edit="0" duplicate="0" delete="0"
            decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="sale_id"/>
                <field name="picking_id"/>
                <field name="type"/>
                <field name="state"/>
                <field name="remarks"/>
            </tree>
        </field>
    </record>


    <record model="ir.actions.act_window" id="action_monta_logs">
        <field name="name">Monta Log</field>
        <field name="res_model">monta.sync.log</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="monta_log_view"/>
    </record>

</odoo>