<odoo>
    <template id="external_layout_boxed" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[contains(@t-attf-class, 'o_report_layout_boxed')]" position="attributes">
            <attribute name="t-attf-style" />
        </xpath>
    </template>
    <template id="external_layout_bold" inherit_id="web.external_layout_bold">
        <xpath expr="//div[contains(@t-attf-class, 'o_report_layout_bold')]" position="attributes">
            <attribute name="t-attf-style" />
        </xpath>
    </template>
    <template id="external_layout_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'o_report_layout_standard')]" position="attributes">
            <attribute name="t-attf-style" />
        </xpath>
    </template>
    <template id="external_layout_striped" inherit_id="web.external_layout_striped">
        <xpath expr="//div[contains(@t-attf-class, 'o_report_layout_striped')]" position="attributes">
            <attribute name="t-attf-style" />
        </xpath>
    </template>
</odoo>
